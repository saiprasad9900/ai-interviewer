# Copy to .env for local development (never commit .env)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI for voice transcription (Whisper)
OPENAI_API_KEY=

# Optional: override SQLite directory on cloud hosts
# DATA_DIR=/tmp/ai_interviewer_data

# Frontend: backend URL (set on Streamlit Cloud to your Render API URL)
# API_BASE=https://your-api.onrender.com
